# Copy to .env on the Mac mini. Never commit .env.
POSTGRES_PASSWORD=
D2D_SECRET_KEY=
ANTHROPIC_API_KEY=
CALIBRATION_BOT_TOKEN=
# Optional: override the config directory (defaults to ./config)
D2D_CONFIG_DIR=
# Deploy only (~/d2d/<env>/.env): host port for the environment's Postgres (production 5432, staging 5433)
D2D_PG_PORT=
# Optional: Postgres host (default 127.0.0.1), or a full SQLAlchemy URL that overrides the keys above,
# e.g. postgresql+psycopg://d2d:<password>@127.0.0.1:5432/d2d
D2D_PG_HOST=
D2D_DATABASE_URL=
# Tests only: throwaway database for tests/integration/test_db.py (the tests drop the ontology schema)
D2D_TEST_DATABASE_URL=
